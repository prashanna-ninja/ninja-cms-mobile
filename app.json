{
  "expo": {
    "name": "Ninja CMS",
    "slug": "ninja-cms-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/Default.png",
    "scheme": "ninjacms",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adviceninja.ninjacms",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A4DB3",
        "foregroundImage": "./assets/app-icons/adaptive-foreground.png",
        "monochromeImage": "./assets/app-icons/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adviceninja.ninjacms"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2D6F",
          "image": "./assets/images/ninja-cms-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ae3853f-8855-4953-a3f6-c05eb91d1e29"
      }
    }
  }
}
